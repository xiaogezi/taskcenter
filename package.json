{
  "name": "taskcenter",
  "version": "0.1.1",
  "description": "Local-first task governance dashboard for Codex and Claude Code agents.",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "codex",
    "claude-code",
    "mcp",
    "agent",
    "task-management"
  ],
  "files": [
    ".openai/hosting.json",
    "app/",
    "build/",
    "data/dispatches.example.json",
    "data/requirements.seed.json",
    "data/session-merges.json",
    "db/",
    "drizzle/",
    "integrations/",
    "public/",
    "scripts/",
    "tests/",
    "worker/",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "drizzle.config.ts",
    "eslint.config.mjs",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:live": "node scripts/dev-live.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "sync": "node scripts/sync-codex.mjs",
    "sync:test": "CODEX_HOME=tests/fixtures TASKCENTER_SEED_PATH=tests/fixtures/requirements.seed.json TASKCENTER_SELECTION_PATH=tests/fixtures/session-selection-all.json TASKCENTER_DASHBOARD_PATH=.local/test-dashboard.json node scripts/sync-codex.mjs",
    "mcp:tasks": "node scripts/taskcenter-mcp.mjs",
    "watch:codex": "node scripts/watch-codex.mjs",
    "control": "node scripts/control-server.mjs",
    "integrations:print": "node scripts/print-integrations.mjs",
    "desktop:install": "bash scripts/macos/build-taskcenter-app.sh",
    "test": "npm run sync:test && npm run build && TASKCENTER_DASHBOARD_PATH=.local/test-dashboard.json node --test tests/*.test.mjs",
    "test:integration": "npm run sync && npm run build && TASKCENTER_DASHBOARD_PATH=data/dashboard.json TASKCENTER_TEST_MODE=integration node --test tests/dashboard.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler --ignore-pattern .local --ignore-pattern .delegate --ignore-pattern .planning --ignore-pattern .runs --ignore-pattern project-context/.obsidian --ignore-pattern project-context/.claudian",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.144.4",
    "drizzle-orm": "0.45.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.1",
    "wrangler": "^4.122.0"
  },
  "type": "module"
}
