{
  "name": "taskcenter",
  "version": "0.1.5",
  "description": "Local-first task governance dashboard for Codex and Claude Code agents.",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "codex",
    "claude-code",
    "mcp",
    "agent",
    "task-management"
  ],
  "files": [
    "app/",
    "config/",
    "data/dispatches.example.json",
    "data/requirements.seed.json",
    "data/session-merges.json",
    "integrations/",
    "public/",
    "scripts/",
    "tests/",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "eslint.config.mjs",
    "postcss.config.mjs",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/vinext-cli.mjs dev",
    "dev:live": "node scripts/dev-live.mjs",
    "build": "node scripts/vinext-cli.mjs build",
    "start": "node scripts/vinext-cli.mjs start",
    "service:start": "node scripts/taskcenter-control.mjs start",
    "service:stop": "node scripts/taskcenter-control.mjs stop",
    "service:status": "node scripts/taskcenter-control.mjs status",
    "service:restart": "node scripts/taskcenter-control.mjs restart",
    "service:deploy": "node scripts/taskcenter-control.mjs deploy",
    "service:prune": "node scripts/taskcenter-control.mjs prune",
    "service:history": "node scripts/taskcenter-control.mjs history",
    "sync": "node scripts/sync-codex.mjs",
    "sync:test": "node scripts/sync-test.mjs",
    "mcp:tasks": "node scripts/taskcenter-mcp.mjs",
    "watch:codex": "node scripts/watch-codex.mjs",
    "jev:watch": "node scripts/jev-advisor.mjs --watch",
    "jev:report": "node scripts/jev-advisor.mjs --report",
    "control": "node scripts/control-server.mjs",
    "integrations:print": "node scripts/print-integrations.mjs",
    "desktop:install": "bash scripts/macos/build-taskcenter-app.sh",
    "test": "npm run sync:test && npm run build && node scripts/run-tests.mjs",
    "test:integration": "npm run sync && npm run build && node scripts/run-tests.mjs --integration",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler --ignore-pattern .local --ignore-pattern .delegate --ignore-pattern .planning --ignore-pattern .runs --ignore-pattern project-context/.obsidian --ignore-pattern project-context/.claudian",
    "mcp:budget": "node scripts/mcp-schema-budget.mjs",
    "size:check": "node scripts/artifact-size-budget.mjs",
    "size:report": "node scripts/artifact-size-budget.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:production:isolated": "node scripts/verify-production.mjs --install",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "vinext": "0.0.45",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "js-tiktoken": "1.0.21",
    "pino": "10.4.0",
    "react-server-dom-webpack": "^19.2.9",
    "rolldown": "1.2.16",
    "rotating-file-stream": "3.2.10",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "^8.3.5"
  },
  "type": "module"
}
