{
  "description": "Conditional additions for the CyberRole scheduled read-only automation; merge with the normal TaskCenter hooks",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__TASKCENTER_ROOT__/scripts/taskcenter-hook.mjs\" scheduled-profile-detect --agent codex --profile scheduled_readonly --automation-id cyberrole-agent-context --project-id cyberrole --workspace-root \"__CYBERROLE_ROOT__\" --report-path \"__ROLLING_REPORT__\" --task-mutation false --pca-mutation false --report-mutation true --network false",
            "timeout": 10,
            "statusMessage": "Detecting scheduled read-only TaskCenter profile",
            "additionalContextLimit": 2000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Read|Grep|Glob|exec_command|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__TASKCENTER_ROOT__/scripts/taskcenter-hook.mjs\" scheduled-pre-tool-use --agent codex",
            "timeout": 10,
            "statusMessage": "Enforcing scheduled TaskCenter capabilities"
          }
        ]
      }
    ]
  }
}
